{
  "expo": {
    "name": "MajorMap",
    "slug": "majormap",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "icon": "./major.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#F6F7FB",
      "barStyle": "dark-content",
