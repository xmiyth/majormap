[Unit]
Description=MajorMap PocketBase
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pocketbase
ExecStart=/home/ubuntu/pocketbase/pocketbase serve majormap.duckdns.org
Restart=on-failure
RestartSec=5
LimitNOFILE=4096
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/pocketbase/pb_data

[Install]
WantedBy=multi-user.target
